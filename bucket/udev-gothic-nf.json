{
    "version": "2.2.0",
    "description": "UDEV Gothic NF - BIZ UDゴシック + JetBrains Mono + Nerd Fonts (日本語コーディング向け)",
    "homepage": "https://github.com/yuru7/udev-gothic",
    "license": "OFL-1.1",
    "url": "https://github.com/yuru7/udev-gothic/releases/download/v2.2.0/UDEVGothic_NF_v2.2.0.zip",
    "hash": "45faeef7b5d8bc591bcc5887a2ca0c5fb9028066f18a5a52cd6f10b7d655ba37",
    "installer": {
        "script": [
            "$fontdir = \"$env:LocalAppData\\Microsoft\\Windows\\Fonts\"",
            "if (-not (Test-Path $fontdir)) { New-Item -Path $fontdir -ItemType Directory -Force | Out-Null }",
            "$reg = 'HKCU:\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Fonts'",
            "Get-ChildItem $dir -Recurse -Filter '*.ttf' | ForEach-Object {",
            "  Copy-Item $_.FullName -Destination $fontdir -Force",
            "  New-ItemProperty -Path $reg -Name ($_.BaseName + ' (TrueType)') -Value \"$fontdir\\$($_.Name)\" -Force | Out-Null",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "$fontdir = \"$env:LocalAppData\\Microsoft\\Windows\\Fonts\"",
            "$reg = 'HKCU:\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Fonts'",
            "Get-ChildItem $dir -Recurse -Filter '*.ttf' | ForEach-Object {",
            "  Remove-ItemProperty -Path $reg -Name ($_.BaseName + ' (TrueType)') -Force -ErrorAction SilentlyContinue",
            "  Remove-Item \"$fontdir\\$($_.Name)\" -Force -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/yuru7/udev-gothic/releases/download/v$version/UDEVGothic_NF_v$version.zip"
    }
}

